{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Share of 5xx responses over the last 5 minutes. Alert GatewayErrorBudgetFastBurn fires above 5% for 10 minutes.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "expr": "sum(rate(gateway_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(gateway_http_requests_total[5m])), 1)",
          "refId": "A"
        }
      ],
      "title": "Error budget burn (5m)",
      "type": "gauge"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Requests per second by status code.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "expr": "sum by (status) (rate(gateway_http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "Request rate by status",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "In-flight HTTP requests reported by the gateway registry.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 3,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": false
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "expr": "gateway_http_active_requests",
          "refId": "A"
        }
      ],
      "title": "Active requests",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Approximate mean request latency per route derived from the gateway duration sum and request counters.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "expr": "sum by (route) (rate(gateway_http_request_duration_seconds_sum[5m])) / clamp_min(sum by (route) (rate(gateway_http_requests_total[5m])), 0.000001)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "title": "Mean latency by route (5m)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Upstream circuit openings and bulkhead rejections across LLM and embedding providers.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
