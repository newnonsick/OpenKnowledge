# ==============================================================================
# LOCAL AI GATEWAY CONFIGURATION (.env.example)
# Copy to .env and customize for your environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gateway Server Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
STORAGE_DIR=./data/storage
DEFAULT_WORKSPACE_ID=global
# Comma-separated list of authorized API keys for Bearer / x-api-key headers
GATEWAY_API_KEYS=sk-gateway-local-dev,sk-gateway-test-key
# Comma-separated allowed origins for CORS
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. Database Persistence Settings (PostgreSQL + pgvector with asyncpg)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gateway_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ------------------------------------------------------------------------------
# 3. Decoupled LLM Backend Settings (OpenAI-compatible)
# ------------------------------------------------------------------------------
LLM_URL=http://localhost:8888
LLM_MODEL_ID=default
LLM_API_KEY=EMPTY
CONTEXT_WINDOW=8192
LLM_TIMEOUT_SECONDS=120.0
LLM_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# 4. Decoupled Embedding Backend Settings (OpenAI-compatible)
# ------------------------------------------------------------------------------
EMBEDDING_URL=http://localhost:7997
EMBEDDING_MODEL_ID=default
EMBEDDING_API_KEY=EMPTY
# Embedding dimension must match vector column dimension (e.g. 768 for nomic, 1024 for bge-large, 1536 for text-embedding-3)
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 5. Chat Orchestration & Tool Interception Guardrails
# ------------------------------------------------------------------------------
MAX_TOOL_ITERATIONS=10
TOOL_TIMEOUT_SECONDS=15.0
KNOWLEDGE_SYSTEM_PROMPT_ENABLED=true
# KNOWLEDGE_SYSTEM_PROMPT_CUSTOM=

