# ==============================================================================
# OPENKNOWLEDGE CONFIGURATION (.env.example)
# Copy to .env and customize for your environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gateway Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=auto
STORAGE_DIR=./data/storage
STORAGE_BACKEND=local
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_SESSION_TOKEN=
STORAGE_S3_PREFIX=
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_GROUP_CLAIM=groups
OIDC_USERNAME_CLAIM=email
OIDC_ROLE_MAPPING={}
OIDC_GROUP_SPACE_MAP={}
OIDC_DEPROVISION_DISABLE=true
DEFAULT_WORKSPACE_ID=global
PUBLIC_BASE_URL=
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
TRUSTED_PROXY_CIDRS=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LEGACY_API_KEYS_ENABLED=false
API_KEY_PEPPERS={"1":"CHANGE_ME"}
ACTIVE_API_KEY_PEPPER_VERSION=1
MFA_ENCRYPTION_KEYS={"1":"REPLACE_WITH_FERNET_KEY"}
ACTIVE_MFA_ENCRYPTION_KEY_VERSION=1
GATEWAY_API_KEYS=
MAX_REQUEST_BODY_BYTES=16777216
MAX_UPLOAD_BYTES=10485760
PARSER_MEMORY_LIMIT_BYTES=134217728
PARSER_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# 2. Database Persistence Settings (PostgreSQL + pgvector with asyncpg)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gateway_db
MIGRATION_DATABASE_URL=
WORKER_DATABASE_URL=
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_IDLE_DELAY_SECONDS=0.5
PARSER_CPU_SECONDS=30
PARSER_MAX_PAGES=500
PARSER_MAX_OUTPUT_CHARACTERS=5000000
INGESTION_CHUNK_SIZE=2000
INGESTION_CHUNK_OVERLAP=200
INGESTION_MAX_CHUNKS=10000
GIT_TIMEOUT_SECONDS=30.0
STORAGE_RECONCILE_INTERVAL_SECONDS=3600
STORAGE_STAGING_TTL_SECONDS=86400
STORAGE_ORPHAN_GRACE_SECONDS=86400
RETENTION_PURGE_ENABLED=false
RETENTION_INTERVAL_SECONDS=86400
RETENTION_ARCHIVE_DAYS=365
RETENTION_REVISION_DAYS=1095
RETENTION_OPERATIONAL_DAYS=30
RETENTION_BATCH_SIZE=100
RETENTION_MAX_BATCHES_PER_CYCLE=100
WORKER_METRICS_INTERVAL_SECONDS=60
WORKER_METRICS_FILE=
EMBEDDING_REEMBED_BATCH_SIZE=64
STALE_AFTER_DAYS=90
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ------------------------------------------------------------------------------
# 3. Decoupled LLM Backend Settings (OpenAI-compatible)
# ------------------------------------------------------------------------------
LLM_URL=http://localhost:8888
LLM_MODEL_ID=default
LLM_FALLBACK_MODEL_IDS=
LLM_API_KEY=EMPTY
# Optional extra headers forwarded to the LLM provider (JSON object).
# Needed by providers that require session routing, e.g.
# LLM_EXTRA_HEADERS={"x-opencode-session":"openknowledge-gateway"}
LLM_EXTRA_HEADERS=
CONTEXT_WINDOW=8192
LLM_TIMEOUT_SECONDS=120.0
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=0.2
LLM_MAX_CONCURRENCY=20
LLM_BULKHEAD_TIMEOUT_SECONDS=1.0
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RECOVERY_SECONDS=30.0
LLM_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# 4. Decoupled Embedding Backend Settings (OpenAI-compatible)
# ------------------------------------------------------------------------------
EMBEDDING_URL=http://localhost:7997
EMBEDDING_MODEL_ID=default
EMBEDDING_API_KEY=EMPTY
# Embedding dimension is frozen by the current schema revision
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30.0
EMBEDDING_RETRY_ATTEMPTS=3
EMBEDDING_RETRY_BACKOFF_SECONDS=0.2
EMBEDDING_MAX_CONCURRENCY=20
EMBEDDING_BULKHEAD_TIMEOUT_SECONDS=1.0
EMBEDDING_CIRCUIT_FAILURE_THRESHOLD=5
EMBEDDING_CIRCUIT_RECOVERY_SECONDS=30.0

# ------------------------------------------------------------------------------
# 5. Chat Orchestration & Tool Interception Guardrails
# ------------------------------------------------------------------------------
MAX_INTERNAL_TOOL_CALLS=32
MAX_REPEATED_TOOL_SIGNATURES=2
MAX_TOOL_WALL_CLOCK_SECONDS=180.0
MAX_TOOL_ITERATIONS=10
TOOL_TIMEOUT_SECONDS=15.0
KNOWLEDGE_SYSTEM_PROMPT_ENABLED=true
# KNOWLEDGE_SYSTEM_PROMPT_CUSTOM=

# ------------------------------------------------------------------------------
# 6. Credential and space budgets (M1-10)
# ------------------------------------------------------------------------------
QUOTA_REQUESTS_PER_MINUTE=120
QUOTA_CONCURRENT_REQUESTS=8
QUOTA_TOKENS_PER_MINUTE=60000
QUOTA_STORAGE_BYTES=1073741824
QUOTA_BURST_REQUESTS=20
