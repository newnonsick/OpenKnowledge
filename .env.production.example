ENVIRONMENT=production
APP_ENV_FILE=.env.production
PUBLIC_DOMAIN=knowledge.example.com
PUBLIC_BASE_URL=https://knowledge.example.com
TRUSTED_HOSTS=knowledge.example.com
TRUSTED_PROXY_CIDRS=172.30.0.0/24
CORS_ORIGINS=https://knowledge.example.com
LEGACY_API_KEYS_ENABLED=false
GATEWAY_API_KEYS=
API_KEY_PEPPERS={"1":"REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"}
ACTIVE_API_KEY_PEPPER_VERSION=1
MFA_ENCRYPTION_KEYS={"1":"REPLACE_WITH_FERNET_KEY"}
ACTIVE_MFA_ENCRYPTION_KEY_VERSION=1
POSTGRES_DB=kinbase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_ADMIN_PASSWORD
GATEWAY_RUNTIME_DB_PASSWORD=REPLACE_WITH_RANDOM_RUNTIME_PASSWORD
GATEWAY_WORKER_DB_PASSWORD=REPLACE_WITH_RANDOM_WORKER_PASSWORD
LLM_URL=http://host.docker.internal:8888
LLM_MODEL_ID=default
LLM_API_KEY=REPLACE_IF_REQUIRED
EMBEDDING_URL=http://host.docker.internal:7997
EMBEDDING_MODEL_ID=default
EMBEDDING_API_KEY=REPLACE_IF_REQUIRED
EMBEDDING_DIMENSION=1024
MAX_REQUEST_BODY_BYTES=16777216
MAX_UPLOAD_BYTES=10485760
PARSER_MEMORY_LIMIT_BYTES=134217728
PARSER_TIMEOUT_SECONDS=60
