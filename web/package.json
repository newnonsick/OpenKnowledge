{
  "name": "ai-knowledge-gateway-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "generate:api": "openapi-typescript lib/generated/openapi.json -o lib/generated/openapi.ts",
    "start": "next start",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "start:standalone": "npm run prepare:standalone && node .next/standalone/server.js",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.33.0",
    "next": "16.3.1",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
